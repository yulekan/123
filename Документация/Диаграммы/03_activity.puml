@startuml
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam activity {
  BackgroundColor #F8F9FA
  BorderColor #212529
  DiamondBackgroundColor #E9ECEF
  DiamondBorderColor #212529
  FontSize 13
}

start
:Выбрать сотрудника, вид СИЗ,\nдату выдачи и количество;
:Определить должность сотрудника;
if (Норма для пары\n«должность + СИЗ» задана?) then (нет)
  :Вывести сообщение\n«Норма не предусмотрена»;
  stop
endif
:Подсчитать количество, выданное\nза последние 12 месяцев;
if (Выдано + запрошено\nне больше нормы?) then (нет)
  :Вывести сообщение\n«Превышена норма выдачи»;
  stop
endif
:Начать транзакцию;
:Уменьшить остаток СИЗ;
if (Остаток достаточен?) then (нет)
  :Откатить транзакцию;
  :Вывести сообщение\n«Недостаточно СИЗ на складе»;
  stop
endif
:Добавить запись в журнал выдачи;
:Зафиксировать транзакцию;
:Обновить журнал и остатки на экране;
stop
@enduml
