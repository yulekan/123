}
object "Норма № 1\n: Норма выдачи" as norm {
  IdNorm = 1
  QtyPerYear = 2
  WearPeriodMonths = 12
}
object "Выдача № 1\n: Выдача СИЗ" as issue {
  IdIssue = 1
  IssueDate = 15.09.2026
  Qty = 2
  Status = "Выдана"
}

emp -- pos : должность
pos -- norm : норма
item -- norm : норма
