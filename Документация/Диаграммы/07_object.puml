@startuml
left to right direction
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam object {
  BackgroundColor #FFFFFF
  BorderColor #212529
  FontSize 14
  HeaderBackgroundColor #EAF2FB
}
skinparam note {
  BackgroundColor #FFFDF3
  BorderColor #C9A227
}

object "Иванов И.И.\n: Сотрудник" as emp {
  IdEmployee = 1
  FullName = "Иванов Иван Иванович"
  HireDate = 12.01.2024
  IsActive = да
}
object "Обвальщик\n: Должность" as pos {
  IdPosition = 3
  Name = "Обвальщик"
}
object "Халат х/б\n: Вид СИЗ" as item {
  IdPPEItem = 1
  Name = "Халат х/б"
  Unit = "шт"
